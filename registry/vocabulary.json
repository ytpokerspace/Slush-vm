{
  "schema_version": "1.0.0",
  "project": "SHUSHOS",
  "purpose": "Emoji-native aliases for canonical language, platform, and command concepts. Emoji are surface syntax; canonical IDs carry semantic identity.",
  "resolution_rules": [
    "Resolve aliases only inside a declared grammar or namespace.",
    "If an alias maps to multiple canonical IDs in the active context, fail with E_ALIAS_AMBIGUOUS.",
    "Never silently select an incompatible implementation.",
    "Canonical IDs are stable; display symbols may change.",
    "Platform-specific entries must declare their platform."
  ],
